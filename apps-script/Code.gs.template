const AQ_SPREADSHEET_ID = "REMPLACER_PAR_ID_DU_TABLEAU";

const AQ_CIRCUITS = {
  A: 18, B: 19, C: 18, D: 20, E: 19, F: 18, G: 13,
  H: 10, I: 17, J: 16, K: 15, L: 13, M: 13
};

const AQ_STATUS_TO_SHEET = {
  todo: "⏳ À faire",
  done: "✅ Fait",
  repost: "🔁 À recoller",
  skip: "⏭️ Passé"
};

const AQ_STATUS_FROM_SHEET = {
  "⏳ À faire": "todo",
  "✅ Fait": "done",
  "🔁 À recoller": "repost",
  "⏭️ Passé": "skip"
};

